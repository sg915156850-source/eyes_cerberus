# Eyes Cerberus host defense daemon.
#
# Installed by install.sh / the .deb, which rewrites the two paths below to the
# directory the code actually landed in. To install by hand from a checkout,
# replace /opt/eyes-cerberus with the checkout path.
#
# This replaces the old Type=oneshot unit: that one launched background workers
# with nohup and exited, so systemd never supervised them and nothing restarted
# them when they died. This unit runs the daemon in the foreground and restarts
# it on any exit.

[Unit]
Description=Eyes Cerberus host defense daemon
Documentation=https://github.com/sg915156850-source/eyes_cerberus
After=network-online.target
Wants=network-online.target
# The daemon cannot report its own death. If it exits for good, this fires one
# notification through the configured NOTIFY_METHOD.
OnFailure=eyes-cerberus-failure.service

[Service]
Type=simple
WorkingDirectory=/opt/eyes-cerberus
ExecStart=/opt/eyes-cerberus/cerberus.sh run
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStopSec=15

# Needs root: kill arbitrary PIDs, read /proc/<pid>/{exe,environ}, chmod files
# owned by anyone, run iptables.
User=root
UMask=0077

# --- Hardening ------------------------------------------------------------
# Root, but not *all* of root. Everything below is what the daemon actually
# uses; anything it does not need is dropped.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_KILL CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

# Deliberately NOT set, with reasons -- do not "harden" these without reading:
#   ProtectSystem=  quarantine has to chmod 000 a payload wherever it lands,
#                   and /etc/let is a known dropper path. Read-only /etc or
#                   /usr would silently turn containment into a no-op.
#   ProtectHome=    /root/*/.next/standalone is a scanned path (that is where
#                   the March 2026 dropper came from).
#   PrivateTmp=     /tmp, /var/tmp and /dev/shm are the volatile directories
#                   the whole hash scan is about. A private /tmp would hide
#                   exactly what we are looking for.
#   SystemCallFilter=  not verified against every distro's iptables/ss build;
#                   an over-tight filter here fails the same silent way v1 did.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cerberus

[Install]
WantedBy=multi-user.target
