# Eyes Cerberus configuration. Copy to etc/cerberus.env and edit.
#   cp etc/cerberus.env.example etc/cerberus.env
# etc/cerberus.env is git-ignored (it may hold a Telegram token). This file is
# sourced by cerberus.sh as plain bash: KEY=value, no spaces around `=`.

# ---------------------------------------------------------------------------
# Sensor loop
# ---------------------------------------------------------------------------
# Seconds between sensor passes.
SENSOR_INTERVAL=30

# ---------------------------------------------------------------------------
# CPU heuristic (SOFT -- alert only, never kills)
# ---------------------------------------------------------------------------
# A process must sit above CPU_THRESHOLD percent for CPU_SUSTAIN_SAMPLES
# consecutive passes before it is reported. This is instantaneous CPU sampled
# by Cerberus, not the ps lifetime average.
CPU_THRESHOLD=85
CPU_SUSTAIN_SAMPLES=4

# ---------------------------------------------------------------------------
# Which SOFT detectors run (1=on, 0=off)
# ---------------------------------------------------------------------------
DETECT_HIGH_CPU=1
DETECT_NEW_LISTENER=1
DETECT_PERSISTENCE=1
DETECT_UPX_NEW=1

# Generic detectors -- these are not tied to the March 2026 incident and are
# what makes the daemon useful on a host that has not met that dropper.
#   revshell  argv shaped like a reverse shell
#   fileless  a process executing from anonymous memory (/memfd:)
#   setuid    new setuid/setgid files, as part of the persistence baseline
#   loader    a cron entry or unit that downloads code and runs it
DETECT_REVSHELL=1
DETECT_FILELESS=1
DETECT_SETUID=1
DETECT_LOADER=1

# Where a newly-appeared setuid binary is worth reporting. Deliberately not the
# whole filesystem: a full find(1) every cycle is expensive, and new setuid
# files under /usr/bin come from package upgrades.
SETUID_DIRS="/tmp /var/tmp /dev/shm /home /root /opt /srv /usr/local"
# Services started on demand that exit when idle; left out of the running-service
# check so their coming and going is not a finding. Unit files are still watched.
UNITS_RUNNING_IGNORE="fwupd.service packagekit.service"

# ---------------------------------------------------------------------------
# Response posture
# ---------------------------------------------------------------------------
# 1 = HARD findings trigger auto kill + quarantine + iptables.
# 0 = everything is alert-only (HARD findings still collect forensics + notify).
AUTO_RESPONSE=1

# Also DROP outbound TCP to the ports in etc/signatures/c2_ports.txt. Off by
# default: an OUTPUT --dport rule affects traffic to that port on every host.
BLOCK_C2_PORTS=0

# Global dry run: when 1, no kill / chmod / iptables is ever executed, only
# logged with a [DRY] prefix. Overridden per-invocation by CERBERUS_DRY_RUN=1.
DRY_RUN=0

# ---------------------------------------------------------------------------
# Log rotation
# ---------------------------------------------------------------------------
# events.jsonl and cerberus.log are rotated by the daemon itself once they pass
# LOG_MAX_BYTES, keeping LOG_KEEP generations (events.jsonl.1 ... .N). A host
# under attack is exactly when the event rate spikes, which is the worst time
# to run the disk out.
LOG_MAX_BYTES=10485760
LOG_KEEP=5

# ---------------------------------------------------------------------------
# Signature updates (cerberus.sh update-sigs)
# ---------------------------------------------------------------------------
# A bundle is a flat tar.gz of *.txt signature files. There is no unverified
# path: without a matching SHA-256 nothing is installed, because these files
# decide what a root process kills. SIGNATURE_SHA256 may be the digest itself
# or the URL of a file containing it.
SIGNATURE_URL=
SIGNATURE_SHA256=

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# log | telegram | webhook | email
NOTIFY_METHOD=log
# Minimum severity to push through notify(): SOFT or HARD.
NOTIFY_MIN_SEVERITY=SOFT

# A SOFT finding stays true on every pass until someone deals with it. It is
# reported when it first appears, then once per ALERT_REPEAT_SECONDS while it
# stays open (0 = every pass, the v2.1.0 behaviour). One that has not been seen
# for ALERT_FORGET_SECONDS counts as gone, and is reported at once if it comes
# back; the daemon never uses less than 3 x SENSOR_INTERVAL x PERSISTENCE_EVERY.
# HARD findings are never held back.
ALERT_REPEAT_SECONDS=86400
ALERT_FORGET_SECONDS=3600

# NOTIFY_METHOD=telegram
TG_TOKEN=
TG_CHAT=

# NOTIFY_METHOD=webhook  (JSON POST-ed as {"text": "..."} )
WEBHOOK_URL=

# NOTIFY_METHOD=email  (needs a working `mail` command)
EMAIL_TO=

# ---------------------------------------------------------------------------
# cerberus.sh ssh (moving sshd off port 22, keys only for root)
# ---------------------------------------------------------------------------
# How long a `stage` or `lock` waits for `cerberus.sh ssh confirm` from a new
# key session on the new port before the previous step is restored by itself.
SSH_CONFIRM_SECONDS=900
# How long to wait for sshd to come up on the new port after applying.
SSH_VERIFY_SECONDS=10
